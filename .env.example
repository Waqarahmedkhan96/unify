POSTGRES_DB=unify_erp
POSTGRES_USER=unify_app
POSTGRES_PASSWORD=change_this_development_password
POSTGRES_PORT=5432
API_HTTP_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
RateLimiting__Enabled=true
RateLimiting__PermitLimit=120
RateLimiting__WindowSeconds=60
Https__RequireHttps=false
Https__HstsDays=365
PasswordReset__FrontendBaseUrl=http://localhost:5080
PasswordReset__SenderEmail=
PasswordReset__SmtpHost=
PasswordReset__SmtpPort=587
PasswordReset__SmtpEnableSsl=true
PasswordReset__SmtpUsername=
PasswordReset__SmtpPassword=

