POSTGRES_DB=unify_erp
POSTGRES_USER=unify_app
POSTGRES_PASSWORD=change_this_development_password
POSTGRES_PORT=5432
API_HTTP_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
RateLimiting__Enabled=true
RateLimiting__PermitLimit=120
RateLimiting__WindowSeconds=60

# Production deployments must provide real values through the host environment
# or a secret manager. Do not commit production secrets.
# ASPNETCORE_ENVIRONMENT=Production
# ConnectionStrings__Default=Host=postgres;Port=5432;Database=unify_erp;Username=unify_app;Password=replace_with_secret
# Jwt__Issuer=Unify.Erp
# Jwt__Audience=Unify.Erp.Client
# Jwt__SigningKey=replace_with_at_least_32_random_characters
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=30
# RateLimiting__Enabled=true
# RateLimiting__PermitLimit=120
# RateLimiting__WindowSeconds=60
# DevelopmentSeed__Enabled=false
